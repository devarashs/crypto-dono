# Copy this file to .env and fill it in. Never commit .env: it will hold secrets.
# Blank values fall back to the default shown; variables without a default are required.

# --- Server ------------------------------------------------------------------

# Public address viewers and NOWPayments use to reach this service, without a
# trailing slash. Must be reachable from the internet for payment webhooks to
# arrive, e.g. your domain, your PaaS URL, or a Cloudflare Tunnel hostname.
# http://localhost:3000 is fine for local development without real payments.
PUBLIC_BASE_URL=

# Interface and port to listen on. Default: 0.0.0.0 and 3000.
HOST=
PORT=

# fatal | error | warn | info | debug | trace. Default: info.
LOG_LEVEL=

# SQLite database file. Default: data/crypto-dono.sqlite, which in Docker is
# inside the mounted ./data volume. Back this file up: it is your donation history.
DATABASE_PATH=

# Shown on the donation page as "Support <name>". Default: a generic heading.
STREAMER_NAME=

# --- NOWPayments ---------------------------------------------------------------

# API key from your NOWPayments dashboard (payment settings, API keys). Required.
NOWPAYMENTS_API_KEY=

# IPN secret from your NOWPayments dashboard (payment settings, Instant payment
# notifications). Every payment webhook is signed with it, and unsigned or
# wrongly signed webhooks are rejected, so nobody else can fire alerts. NOWPayments
# shows it in full only once, when you generate it. Required.
NOWPAYMENTS_IPN_SECRET=

# true to use the NOWPayments sandbox (api-sandbox.nowpayments.io), which needs a
# separate sandbox account and keys. Default: false.
NOWPAYMENTS_SANDBOX=

# --- Donations -----------------------------------------------------------------

# Fiat currency donors enter amounts in, as an ISO 4217 code. Donors still pay in
# crypto; NOWPayments converts. Default: usd.
DONATION_CURRENCY=

# Smallest and largest accepted amount, in DONATION_CURRENCY. Defaults: 1 and 1000.
# NOWPayments also has a per-coin minimum; set this at or above the minimum of
# the coins you expect donors to use, or small donations will fail at checkout.
DONATION_MIN_AMOUNT=
DONATION_MAX_AMOUNT=

# --- Alerts --------------------------------------------------------------------

# Payment status at which a donation's alert is shown on stream:
#   confirming  as soon as the transaction is seen on the blockchain. Fastest,
#               but could alert for a payment that never confirms.
#   confirmed   once the blockchain has confirmed it (default). Usually under a
#               minute for LTC, TRX or SOL, but 10 to 60 minutes for BTC.
#   finished    once the funds have reached your wallet. Slowest.
ALERT_ON_STATUS=

# Secret part of the OBS overlay URL: <PUBLIC_BASE_URL>/overlay/<OVERLAY_TOKEN>.
# Anyone with the URL can watch your alert feed, so make it long and random:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Required. Changing it means updating the URL in OBS.
OVERLAY_TOKEN=

# How long each alert stays on screen, in seconds (2 to 60). Default: 8.
ALERT_DURATION_SECONDS=

# Alert headline. {name} and {amount} are replaced for each donation.
# Default: {name} donated {amount}
ALERT_TEXT_TEMPLATE=

# Your own sound and image, as file names inside CUSTOM_ASSETS_DIR. See
# custom/README.md. ALERT_SOUND empty plays the built-in chime; "none" is silent.
ALERT_SOUND=
ALERT_IMAGE=

# Folder the files above are read from. Default: custom (mounted read-only in Docker).
CUSTOM_ASSETS_DIR=

# --- Text-to-speech (optional) ------------------------------------------------

# Address of a Piper server that reads alerts aloud. Leave empty for no speech.
#   With Docker Compose: start with `docker compose --profile tts up` and set
#     TTS_URL=http://piper:5000
#   With npm start: run Piper separately, e.g.
#     docker build -t crypto-dono-piper ./piper
#     docker run -p 5000:5000 -v piper-voices:/voices crypto-dono-piper
#   and set TTS_URL=http://localhost:5000
TTS_URL=

# What is read aloud. {name}, {amount} and {message} are replaced.
# Default: {name} donated {amount}. {message}
TTS_TEMPLATE=

# Piper voice, used by the compose piper service. Default: en_US-ljspeech-medium
# (public-domain training data). Voices: https://huggingface.co/rhasspy/piper-voices
# Many voices are licensed for non-commercial use only: read the voice's
# MODEL_CARD before using it on a monetised stream.
PIPER_VOICE=

# --- Admin page -------------------------------------------------------------

# Password for /admin: donation history, replay and skip alerts, your overlay and
# test-alert links. At least 12 characters. Leave empty to disable the admin page.
# Sign-in sessions are signed with a key created automatically in the data folder.
ADMIN_PASSWORD=

# --- Message filtering ---------------------------------------------------------

# Longest message a donor may write, in characters (10 to 500). Default: 300.
MESSAGE_MAX_LENGTH=

# Comma-separated words or phrases to hide, matched case-insensitively as whole
# words. Shown on stream as stars and skipped when read aloud. The donor's
# original text is still stored. Catches plain use, not deliberate misspellings.
#   BANNED_WORDS=badword,another bad phrase
BANNED_WORDS=

# Minimum donation, in DONATION_CURRENCY, for the message to be shown on stream.
# Below it the alert still shows the name and amount. Default: 0 (always shown).
MESSAGE_MIN_AMOUNT=

# Minimum donation for the alert to be read aloud (needs TTS_URL). Default: 0.
TTS_MIN_AMOUNT=
